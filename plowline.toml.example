[plowline]
trunk = "main"
remote = "origin"
gate = "python -m pytest -q"     # must pass on the merged train; or a list: ["ruff check .", "python -m pytest -q"]
review = "builtin:claude"        # "builtin:codex", any command (exit 0 = GO), or "" for none
regenerate = ""                  # optional: rebuild generated files on the merged tree
generated = []                   # files regenerate rebuilds, e.g. ["package-lock.json"]; a conflict only there takes the trunk's side
agent = "claude"                 # what `pl open` starts in a lane's terminal
repair = ""                      # optional: runs your agent unattended on a bounced lane; {lane}, {path}, {notice} (write them bare: they arrive quoted)
repair_attempts = 2              # automatic repairs per lane before "split this lane or re-plan"
land = "push"                    # "push" to the trunk, or "pr": open one pull request per train
on_land = ""                     # optional: runs after each landing (deploy, tag, notify)
strict_paths = false             # true: a lane that changes files outside its --paths bounces at pl done
max_lanes = 0                    # cap on lanes not yet landed; 0 for no cap
worktrees = "../{repo}-lanes"    # where lane worktrees live
env = ""                         # "stanchion" gives each lane its own database and ports; "off" turns it off

# builtin:mutants: add it last in gate, e.g. gate = ["ruff check .", "python -m pytest -q", "builtin:mutants"],
# to mutation-test the lines each train changed. The engine is yours to install (mutmut, StrykerJS, Stryker.NET,
# cargo-mutants, Gremlins); `pl check --explain` shows what it would run.
# [mutants]
# max_survivors = 0              # survivors on changed lines a train may keep
# budget = 600                   # seconds for all engines in one run; over it the train stops, no lane is blamed
# skip = []                      # globs never mutated, e.g. ["src/legacy/**"]
#
# [mutants.engines.kt]           # any other extension, or a replacement for a built-in engine
# command = "python tools/mutate_kotlin.py {ranges}"   # {files} {ranges} {base} {head} {diff}; exit 0 = none, 1 = survivors
